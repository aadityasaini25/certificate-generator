# ---------------------------------------------------------------------------
# Certificate — environment variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# `allowPublicKeyRetrieval=true` is needed for MySQL 8.4+/9.x, whose default
# caching_sha2_password plugin encrypts the password with a key fetched from
# the server. Safe over loopback. In production prefer a TLS connection
# (?ssl=true) over public-key retrieval.
DATABASE_URL="mysql://certificate_app:CHANGE_ME@localhost:3306/certificate_db?allowPublicKeyRetrieval=true&connectionLimit=10"

# Scratch database Prisma Migrate uses to verify migrations in development.
# Not needed in production (`prisma migrate deploy` never uses one).
SHADOW_DATABASE_URL="mysql://certificate_app:CHANGE_ME@localhost:3306/certificate_db_shadow?allowPublicKeyRetrieval=true&connectionLimit=2"

# --- Application -----------------------------------------------------------
# Public base URL of the app. Used for absolute links (e.g. e-mail, PDFs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Authentication --------------------------------------------------------
# Secret used to sign admin session cookies.
# Generate a fresh one per environment:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
# Admin session lifetime in seconds (default: 8 hours)
AUTH_SESSION_MAX_AGE="28800"

# --- File storage ----------------------------------------------------------
# Root directory for uploaded documents and generated certificates.
# Relative paths resolve from the project root. In production point this at a
# persistent volume outside the deployment directory, e.g. /var/app/storage
STORAGE_ROOT="./storage"
# Maximum size of a single uploaded file, in bytes (default: 20 MB)
MAX_UPLOAD_SIZE_BYTES="20971520"
# Same limit, exposed to the browser for client-side checks.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES="20971520"

# --- Initial admin account (used by `npm run db:seed` only) ----------------
SEED_ADMIN_EMAIL="admin@certificate.local"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"

# --- Public request form ---------------------------------------------------
# Organisation named in the privacy-consent sentence and the privacy link.
# Left neutral until the client confirms which brand we may display.
NEXT_PUBLIC_ORGANISATION_NAME=""
# Real privacy statement URL. While empty the consent text renders as plain
# text instead of a link — no URL is invented.
NEXT_PUBLIC_PRIVACY_POLICY_URL=""

# --- Certificate issuing organisation --------------------------------------
# Printed on generated certificate PDFs. While NEXT_PUBLIC_ORGANISATION_NAME
# is empty, certificates are stamped "ORGANISATION NOT CONFIGURED" so a
# development certificate cannot be mistaken for an issued one.
ORGANISATION_ADDRESS=""
ORGANISATION_WEBSITE=""

# --- Cloudflare Turnstile (CAPTCHA) ----------------------------------------
# Development uses Cloudflare's published TEST keys below. They call the real
# siteverify API but always return "pass", so they must be replaced before
# production — the app refuses to boot in production if they are still set.
# Get real keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Public request status page --------------------------------------------
# How much of the applicant's name the public status page shows:
#   masked (default) -> "MAMTA S."   full -> "MAMTA SAINI"   hidden -> omitted
# Masked by default: anyone holding a reference ID can see this, so a full name
# is only published if the client decides that is acceptable.
NEXT_PUBLIC_STATUS_APPLICANT_NAME="masked"

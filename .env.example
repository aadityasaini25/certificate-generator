# ===========================================================================
# Certificate — environment template
#
# Copy to .env and fill in. NEVER commit a real .env: this file must only
# ever contain placeholders.
#
# Requires PHP 8.3+ with: pdo_mysql, mbstring, gd, zip, fileinfo, curl,
# openssl, tokenizer, xml, ctype, json, bcmath
# ===========================================================================

APP_NAME="Certificate"

# local | production
APP_ENV=local

# Generate with: php artisan key:generate
APP_KEY=

# MUST be false in production — a stack trace exposes configuration.
APP_DEBUG=true

# The public origin, with scheme and no trailing slash.
#
# IMPORTANT: every certificate's QR code encodes {APP_URL}/verify/{number}.
# A certificate is a permanent document, so one issued while this points at
# the wrong host carries an unscannable QR forever — the only fix is to
# reissue it. Set this correctly BEFORE issuing any production certificate.
#
#   local:      http://localhost:8000
#   production: https://your-domain.example
APP_URL=http://localhost:8000

APP_LOCALE=en

# Use "error" in production; "debug" writes far too much.
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# On cPanel the database and user names are prefixed with your account name,
# e.g. cpaneluser_certificate / cpaneluser_certuser.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certificate_db
DB_USERNAME=certificate_app
DB_PASSWORD=

# --- Session / cache -------------------------------------------------------
# File-based on purpose: no Redis and no queue worker, so this runs on shared
# hosting unchanged. storage/ must be writable by PHP.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

# MUST be true in production (HTTPS). Leave false for plain-HTTP local dev,
# or the session cookie is never sent and login appears to silently fail.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Uploads ---------------------------------------------------------------
# 20 MB. The server's upload_max_filesize and post_max_size must be at least
# this large, or uploads fail before the application sees them.
MAX_UPLOAD_SIZE_BYTES=20971520

# --- Organisation printed on certificates ----------------------------------
# While ORGANISATION_NAME is empty, every generated certificate is stamped
# "ORGANISATION NOT CONFIGURED", so a development document can never be
# mistaken for an issued one. Set it before going live.
ORGANISATION_NAME=""
ORGANISATION_ADDRESS=""
ORGANISATION_WEBSITE=""

# --- Privacy consent -------------------------------------------------------
# Named in the consent sentence on the request form. No policy URL is
# invented: while empty, the statement renders as plain text, not a dead link.
PRIVACY_ORGANISATION_NAME="our organisation"
PRIVACY_POLICY_URL=""
SUPPORT_EMAIL="support@example.com"

# --- Public status page ----------------------------------------------------
# How much of the applicant's name the public status page reveals:
#   masked (default) -> "MAMTA S."    full -> "MAMTA SAINI"    hidden -> omitted
# Masked by default: anyone holding a reference ID can see this.
STATUS_APPLICANT_NAME=masked

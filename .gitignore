# Certificate — Laravel application

/node_modules
/vendor
/public/build
/public/hot
/public/storage

# Environment: real secrets are never committed, the template is.
.env*
!.env.example

# Applicant uploads and generated certificates are real data and must never
# be committed. The directories themselves are kept so a fresh deployment has
# somewhere to write.
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/certificates/*
!/storage/certificates/.gitkeep

# Laravel runtime state. The directories are kept (see the .gitignore files
# inside them) because the framework needs them to exist at boot.
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
# NOTE: these patterns exclude the CONTENTS of each directory, not the
# directory itself — git cannot un-ignore a file inside an excluded directory,
# and the directories must survive a fresh clone for the framework to boot.
/storage/framework/cache/data/*
# mPDF writes generated font metrics here on first render. It is derived data
# that the library recreates on demand, so it must never be committed.
/storage/framework/cache/mpdf/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!/storage/framework/**/.gitignore

# Generated bootstrap SQL (contains the real database password).
/scripts/init-database.sql

# Database backups taken before the migration — real data.
/backups

/.phpunit.cache
.phpunit.result.cache
npm-debug.log*
.DS_Store
*.pem

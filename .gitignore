# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, the template does
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# local file storage (uploaded documents, generated certificates)
/storage/*
!/storage/.gitkeep

# generated bootstrap SQL (contains the real database password)
/scripts/init-database.sql

# auto-generated by Next.js on dev start
/AGENTS.md
/CLAUDE.md
backups/

# --- Laravel ---
/vendor
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!/storage/framework/**/.gitignore
/.phpunit.cache
.phpunit.result.cache

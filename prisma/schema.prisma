// ---------------------------------------------------------------------------
// Certificate — Prisma schema (MySQL)
//
// Design notes
//  - Frequently searched / filtered fields are real columns so MySQL can index
//    them. Volatile, form-specific fields live in the `additionalData` JSON
//    column so the submission form can gain or lose fields without a migration.
//  - `SubmissionRemark` doubles as the audit trail (fromStatus -> toStatus),
//    which keeps us from needing a separate status-history table.
//  - Files are never stored in the database; only their relative storage path
//    is, so the storage backend can move from local disk to a server volume or
//    object storage without touching the schema.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Extend by adding a value here plus a migration; application-facing labels
/// and colours live in `src/lib/constants.ts`.
enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  REVIEWER
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// bcrypt hash — never store or return the plaintext password
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedSubmissions CertificateSubmission[] @relation("SubmissionReviewer")
  remarks             SubmissionRemark[]
  issuedCertificates  Certificate[]
  sessions            AdminSession[]

  @@map("admins")
}

/// Server-side admin sessions.
///
/// Sessions are stored rather than encoded into a signed cookie so that logout
/// can genuinely revoke them: deleting the row ends the session immediately,
/// whereas a self-contained token stays valid until it expires no matter what
/// the browser does. It also makes "sign out everywhere" and session auditing
/// possible without another redesign.
model AdminSession {
  id String @id @default(cuid())

  /// HMAC-SHA256 of the opaque token held by the cookie, keyed with
  /// AUTH_SECRET. The raw token is never stored, so read access to this table
  /// is not enough to impersonate an administrator.
  tokenHash String @unique

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  /// Recorded for audit only; never used to make an authorisation decision.
  ipAddress String?
  userAgent String? @db.Text

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ---------------------------------------------------------------------------
// Certificate submission — created by the public user, reviewed by an admin
// ---------------------------------------------------------------------------

model CertificateSubmission {
  id String @id @default(cuid())

  /// Human-facing tracking number shown to the applicant, e.g. CRT-2026-000123
  referenceNo String @unique

  // --- Section 1: Applicant information -----------------------------------
  applicantName        String
  applicantEmail       String
  applicantPhone       String?
  applicantDesignation String?

  /// Office / country the request is directed to. Required by the public form
  /// and filterable in the admin panel, so it earns a real indexed column
  /// rather than a slot in `additionalData`. Nullable so that future intake
  /// forms which do not ask for it can still create submissions.
  location String?

  // --- Section 2: Company information -------------------------------------
  companyName           String?
  companyRegistrationNo String?
  companyAddressLine1   String?
  companyAddressLine2   String?
  companyCity           String?
  companyState          String?
  companyPostalCode     String?
  companyCountry        String?
  companyEmail          String?
  companyPhone          String?
  companyWebsite        String?

  // --- Section 3: Certificate information ---------------------------------
  certificateType     String?
  purpose             String?   @db.Text
  requestedValidFrom  DateTime?
  requestedValidUntil DateTime?

  // --- Section 4: Product / document information --------------------------
  productName        String?
  productDescription String? @db.Text
  productModel       String?
  hsCode             String?
  originCountry      String?
  quantity           String?

  // --- Section 5: Additional information ----------------------------------
  additionalNotes String? @db.Text
  /// Escape hatch for form fields added after launch. Keys are field names as
  /// defined in the form schema; nothing here is indexed or queried directly.
  additionalData  Json?

  // --- Section 7: Declaration ---------------------------------------------
  declarationAccepted Boolean   @default(false)
  declaredBy          String?
  declaredAt          DateTime?

  // --- Workflow ------------------------------------------------------------
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   Admin?           @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Captured server-side for abuse tracing; never accepted from the client.
  submitterIp String?

  documents   UploadedDocument[]
  remarks     SubmissionRemark[]
  certificate Certificate?

  @@index([status])
  @@index([submittedAt])
  @@index([location])
  @@index([applicantEmail])
  @@index([companyName])
  @@index([reviewedById])
  @@map("certificate_submissions")
}

// ---------------------------------------------------------------------------
// Uploaded documents
// ---------------------------------------------------------------------------

model UploadedDocument {
  id           String                @id @default(cuid())
  submissionId String
  submission   CertificateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Logical slot the file was uploaded against, e.g. REGISTRATION_CERTIFICATE
  documentType String
  originalName String
  /// Randomised on-disk filename — never trust the client-supplied name
  storedName   String
  /// Path relative to the storage root, so the root can be relocated freely
  storagePath  String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  @@index([submissionId])
  @@map("uploaded_documents")
}

// ---------------------------------------------------------------------------
// Remarks / audit trail
// ---------------------------------------------------------------------------

model SubmissionRemark {
  id           String                @id @default(cuid())
  submissionId String
  submission   CertificateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  message String @db.Text

  /// Set when the remark accompanies a status change, making this row an
  /// audit-trail entry as well as a note.
  fromStatus SubmissionStatus?
  toStatus   SubmissionStatus?

  /// Internal notes stay inside the admin panel; non-internal remarks are
  /// safe to surface to the applicant.
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([submissionId])
  @@index([adminId])
  @@map("submission_remarks")
}

// ---------------------------------------------------------------------------
// Generated certificate
// ---------------------------------------------------------------------------

model Certificate {
  id            String                @id @default(cuid())
  certificateNo String                @unique
  submissionId  String                @unique
  submission    CertificateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Selects the render template; changing the design later means adding a
  /// template module and pointing new certificates at its key.
  templateKey String @default("default")

  /// Frozen copy of the submission data at issue time so a later edit to the
  /// submission can never silently change an already-issued certificate.
  snapshot Json

  /// Relative path of the rendered PDF within the storage root.
  filePath String?

  issuedAt   DateTime  @default(now())
  validFrom  DateTime?
  validUntil DateTime?

  issuedById String?
  issuedBy   Admin?  @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  revokedAt    DateTime?
  revokeReason String?   @db.Text

  @@index([issuedById])
  @@map("certificates")
}
